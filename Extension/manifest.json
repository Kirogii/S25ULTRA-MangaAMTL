{
  "manifest_version": 3,
  "name": "Manga Translator — Android NPU",
  "version": "3.0.4",
  "description": "Galaxy S25 Ultra localhost manga translation with Samsung language packs or Qwen NPU models.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
	"declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manga Translator Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["android.js", "languages.js", "content.js", "reader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["reader.js", "Sounds/*"], "matches": ["<all_urls>"] }
  ]
}
